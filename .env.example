# ─── Required Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in actual values.
# NEVER commit .env to source control.

# PostgreSQL connection string (from Neon or any PostgreSQL provider)
# Format: Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require
ConnectionStrings__DefaultConnection=Host=your-neon-host.neon.tech;Database=freelancer_portfolio;Username=your_user;Password=your_password;SSL Mode=Require

# JWT Configuration
# SecretKey MUST be at least 32 characters long
JWT__SecretKey=your-super-secret-key-that-is-at-least-32-chars-long!
JWT__Issuer=https://your-api.onrender.com
JWT__Audience=FreelancerPortfolioAPI
JWT__AccessTokenExpireMinutes=15
JWT__RefreshTokenExpireDays=7

# CORS - comma-separated list of allowed frontend origins
Cors__AllowedOrigins=https://your-app.vercel.app,https://your-custom-domain.com

# Environment
ASPNETCORE_ENVIRONMENT=Production

# Development seed (only used in Development environment)
DevSeed__AdminPassword=Admin@12345
